{
  "schema_version": 1,
  "credential_policy": {
    "repository_env_files": false,
    "default_root": "~/.codex/secrets",
    "never_copy_or_print_secrets": true
  },
  "provider_request_contract": {
    "schema": "media-understanding/provider-operation/v1",
    "states": [
      "not_sent",
      "rejected",
      "accepted",
      "acceptance_unknown",
      "completed"
    ],
    "automatic_retry_requires": [
      "proven_not_sent",
      "proven_not_accepted"
    ],
    "acceptance_unknown_no_resubmit": true,
    "accepted_empty_result_no_resubmit": true,
    "resume_preserves_no_resubmit": true,
    "provider_idempotency_key": "not_assumed",
    "evidence": [
      "operation_fingerprint",
      "provider_request_id",
      "usage",
      "per_attempt_response",
      "retry_disposition"
    ]
  },
  "routes": [
    {
      "id": "kimi-trimodal-swarm",
      "status": "active_if_configured",
      "media": [
        "video"
      ],
      "tasks": [
        "audio_visual",
        "timeline",
        "course_screen_visual"
      ],
      "provider": "kimi_configured_profile",
      "model": "MiniMax-M3",
      "authorization": "explicit_external_provider",
      "credentials": null,
      "configuration_owner": "kimi_code",
      "executor": {
        "kind": "script",
        "path": "scripts/providers/kimi_trimodal.py"
      },
      "mode": "swarm",
      "default_observers": 3,
      "frames_per_second": 2,
      "output_convention": "video_parent/frames_<video_stem>",
      "notes": "Local full-density frames + WAV + cached Whisper word timestamps, then three fresh Kimi M3 observers each read all frames, audio carrier and transcript. Black MP4 audio carrier is experimental, not proven native audio input. M3 acoustic understanding is unverified; ASR semantics are not hearing.",
      "acoustic_understanding": "unverified_experimental"
    },
    {
      "id": "kimi-readmedia",
      "status": "active_if_configured",
      "media": [
        "image",
        "video"
      ],
      "tasks": [
        "video_summary",
        "video_qa",
        "course_screen_visual",
        "image_qa"
      ],
      "provider": "kimi_configured_profile",
      "model": "MiniMax-M3",
      "known_models": [
        "MiniMax-M3",
        "agnes-3.0-flash"
      ],
      "authorization": "explicit_external_provider",
      "credentials": null,
      "configuration_owner": "kimi_code",
      "executor": {
        "kind": "script",
        "path": "scripts/providers/kimi_readmedia.py"
      },
      "mode": "single",
      "notes": "Kimi built-in ReadMediaFile; exact configured API profile. Agnes native video is an explicitly authorized compatibility experiment until verified; video_in is a local declaration, not provider evidence."
    },
    {
      "id": "kimi-readmedia-swarm",
      "status": "active_if_configured",
      "media": [
        "image",
        "video"
      ],
      "tasks": [
        "video_summary",
        "video_qa",
        "course_screen_visual",
        "image_qa"
      ],
      "provider": "kimi_configured_profile",
      "model": "MiniMax-M3",
      "known_models": [
        "MiniMax-M3",
        "agnes-3.0-flash"
      ],
      "authorization": "explicit_external_provider",
      "credentials": null,
      "configuration_owner": "kimi_code",
      "executor": {
        "kind": "script",
        "path": "scripts/providers/kimi_readmedia.py"
      },
      "mode": "swarm",
      "default_observers": 3,
      "notes": "Pass --mode swarm; three independent fresh contexts inspect the same inputs and task, then primary agent synthesizes. Explicit --observers changes count; no fork/resume/peer report reads."
    },
    {
      "id": "minimax-mmx-image",
      "status": "active_if_configured",
      "media": [
        "image"
      ],
      "tasks": [
        "holistic",
        "image_qa",
        "ocr_assist"
      ],
      "provider": "minimax",
      "model": null,
      "authorization": "implicit_current_attachment_request",
      "default_for": [
        "nonvision_host_single_image_understanding"
      ],
      "authorization_scope": "current_request_single_image_only",
      "cost_scope": "one_default_minimax_image_call",
      "fallback_policy": "requires_user_opt_in",
      "credentials": {
        "file": "~/.codex/secrets/minimax.env",
        "required_env": [
          "MINIMAX_API_KEY"
        ],
        "optional_env": [
          "MINIMAX_BASE_URL"
        ]
      },
      "executor": {
        "kind": "cli",
        "command": "mmx",
        "args": [
          "vision",
          "describe"
        ],
        "skill": "~/.agents/skills/mmx-cli/SKILL.md"
      },
      "notes": "Verified mmx 1.0.28: Coding Plan VLM endpoint, no exposed model id. Runtime must bind --api-key, --base-url and --region together; environment key alone does not select ordinary-request auth. See references/minimax-cli.md."
    },

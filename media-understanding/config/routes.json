        "required_env": [
          "MINIMAX_API_KEY"
        ],
        "optional_env": [
          "MINIMAX_BASE_URL"
        ]
      },
      "executor": {
        "kind": "script",
        "path": "scripts/providers/minimax_m3_course_audio.py"

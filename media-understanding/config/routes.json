      "tasks": [
        "asr",
        "timestamps",
        "srt",
        "vtt",
        "speakers"
      ],
      "provider": "minimax",
      "model": "asr-1.0",
      "authorization": "explicit_external_provider",
      "credentials": {
        "file": "~/.codex/secrets/minimax.env",
        "required_env": [
          "MINIMAX_API_KEY"
        ],
        "optional_env": [
          "MINIMAX_BASE_URL"
        ]
      },
      "executor": {
        "kind": "cli",
        "command": "mmx",
        "args": [
          "speech",
          "transcribe"
        ],
        "skill": "~/.agents/skills/mmx-cli/SKILL.md",
        "minimum_version": "1.0.26"
      },
      "input_contract": {
        "max_seconds": 500,
        "max_file_bytes": 50000000,
        "file_input": "local_audio_file; extract audio from video before this step",
        "response_formats": [
          "json",
          "verbose_json",
          "srt",
          "vtt"
        ],
        "streaming": "json only"
      },
      "notes": "Requires mmx speech transcribe (introduced 1.0.26); inspect installed help before execution. Bind exact key, API host and region in memory. Provider POST not run by route check; no automatic retry after unknown acceptance."
    },

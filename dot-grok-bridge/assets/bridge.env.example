# Nonfunctional template. Bind real HTTPS host and private credentials before use.
# Values are unquoted KEY=value for the reference loader; do not use export.
PUBLIC_BASE_URL=https://bridge.example
BIND_HOST=127.0.0.1
PORT=8787
DB_PATH=/var/lib/ob-bridge/bridge.sqlite3
ADMIN_KEY=
GROK_KEY=
GROK_WEBHOOK_URL=
GROK_WEBHOOK_KEY=
BOT_ROUTES_FILE=/etc/ob-bridge-bots.json
# Exact hostnames returned by the actual Dot subscription handshake.
CALLBACK_HOSTS=
OAUTH_REDIRECT_HOSTS=chatgpt.com,chat.openai.com
# Zero means no configured cap; provider constraints remain separate.
MAX_COMPLETED_TURNS=0
MAX_MESSAGES_PER_DAY=0
CONVERSATION_TIMEOUT_SECONDS=604800
CLAIM_TIMEOUT_SECONDS=86400

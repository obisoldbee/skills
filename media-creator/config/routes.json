{
  "schema": "media-creator-routes/v1",
  "scope": {
    "kind": "non_native_media_generation",
    "codex_ordinary_image_generation": {
      "action": "exclude",
      "owner": "imagegen",
      "operations": [
        "text_to_image",
        "image_to_image",
        "multi_image"
      ],
      "reason": "Preserve Codex's built-in image-generation trigger and execution path."
    }
  },
  "execution_contract": {
    "planner": "originating_main_task",
    "final_payload": {
      "required_before_handoff": true,
      "creative_authority": "originating_main_task",
      "worker_mutation": "mechanical_mapping_only"
    },
    "luna_max": {
      "route": "luna-max",
      "model": "gpt-5.6-luna",
      "reasoning": "max",
      "thread": "visible",
      "surface": "visible_thread",
      "orchestrator": "project-handoff",
      "enabled_when": "visible_task_creation_authority_explicit",
      "created_and_validated_by": "originating_main_task"
    },
    "authorization": {
      "provider_execution_authority": {
        "ordinary_browser_generation_request": "one_bounded_provider_submission",
        "prompt_planning_preview_dry_run": "not_granted",
        "does_not_grant": "visible_task_creation_authority"
      },
      "visible_task_creation_authority": {
        "ordinary_browser_generation_request": "not_granted",
        "granted_only_by_explicit_request": [
          "new_task",
          "new_thread",
          "handoff",
          "luna_visible_task"
        ],
        "create_thread_without_authority": false
      },
      "non_execution_modes": {
        "modes": ["prompt", "planning", "preview", "dry_run"],
        "open_browser": false,
        "provider_call": false,
        "create_thread": false
      },
      "decision": {
        "explicit_visible_task_authority": "create_one_bounded_luna_visible_task",
        "current_task_browser_available": "execute_in_current_task",
        "current_task_browser_unavailable_without_visible_authority": "needs_visible_task_authority"
      },
      "additional_task_or_submission": "requires_new_authority"
    },
    "worker": {
      "executor": "ego-browser",
      "execution_role": "browser_worker",
      "handoff_depth": 1,
      "recursive_dispatch": false,
      "action": "execute_envelope_directly"
    },
    "current_task_browser": {
      "capability": "runtime_verified_browser_executor",
      "executor_preference": "ego-browser",
      "execution_role": "browser_executor",
      "handoff_depth": 0,
      "recursive_dispatch": false,
      "action": "execute_envelope_in_current_task"
    },
    "cross_harness": {
      "current_task_execution_requires": [
        "provider_execution_authority",
        "verified_browser_executor_capability"
      ],
      "visible_task_creation_requires": [
        "explicit_visible_task_creation_authority",
        "project_handoff_visible_task_surface"
      ],
      "requirements_are_conjunctive": true,
      "preferred_local_executor": "ego-browser",
      "is_fallback_after_luna_creation_failure": false,
      "explicit_luna_request_may_downgrade": false
    },
    "submission": {
      "pre_submission_manual_or_login_check": "handoff_and_pause",
      "nonzero_or_ambiguous_cost": "pause_before_submission",
      "duplicate_submission": false,
      "post_submission_provider_switch": false,
      "download_retry": "same_submitted_result_only"
    }
  },
  "policies": {
    "non_codex_text_to_image": {
      "primary": "chatgpt-web-image",
      "primary_preconditions": {
        "platform": "Darwin",
        "ego_browser": "present",
        "chatgpt_login": "required_at_runtime"
      },
      "pre_submission_fallback": "minimax-mmx-image",
      "fallback_phase": "before_submission_only",
      "fallback_when": [
        "platform_is_not_Darwin",
        "ego_browser_missing",
        "browser_capability_absent_before_browser_route_selection"
      ],
      "fallback_exclusions": [
        "login_or_manual_check_required",
        "luna_creation_failed",
        "visible_task_handoff_failed",
        "explicit_luna_request",
        "browser_route_selected_without_visible_task_authority",
        "prompt_or_task_submitted"
      ],
      "agnes_selection": "explicit_or_user_confirmed",
      "post_submission_cross_provider_fallback": "none"
    },
    "image_to_image": {
      "never_route_to": [
        "minimax-mmx-image"
      ],
      "agnes_selection": "explicit_or_user_confirmed",
      "reason": "MMX subject reference is not general image-to-image or multi-image editing."
    },
    "minimax_video_quota": {
      "check_before_default_mmx": true,
      "probe": {
        "kind": "external_cli",
        "command": [
          "mmx",
          "quota",
          "show",
          "--output",
          "json",
          "--quiet",
          "--non-interactive"
        ],
        "invoked_by_local_check": false
      },
      "states": {
        "known_positive": "continue_mmx",
        "known_exhausted": "ask_user_mmx_or_agnes",
        "unknown": "ask_user_mmx_or_agnes"
      },
      "h3_quota_authoritative": false,
      "h3_note": "The Token Plan quota result is not authoritative for pay-as-you-go H3 usage."
    },
    "music": {
      "primary": "minimax-web-music",
      "selection": "default_for_generic_original_song_or_instrumental_bgm",
      "default_count": 1,
      "web_music_failure": "stop_and_report",
      "post_submission_fallback": "none",
      "mmx_music_api": "explicit_and_runtime_eligibility_gated",
      "speech_route": "minimax-mmx-speech"
    }
  },
  "routes": [
    {
      "id": "chatgpt-web-image",
      "provider": "chatgpt_web",
      "status": "active_if_available",
      "selection": "non_codex_default_when_preconditions_hold",
      "executor": {
        "kind": "authority_gated_browser_execution",
        "current_task": {
          "kind": "verified_browser_executor",
          "preferred_command": "ego-browser",
          "requires_visible_task_creation_authority": false
        },
        "visible_task": {
          "kind": "project_handoff_visible_thread",
          "orchestrator": "project-handoff",
          "route": "luna-max",
          "model": "gpt-5.6-luna",
          "reasoning": "max",
          "surface": "visible_thread",
          "requires_visible_task_creation_authority": true,
          "worker": {
            "kind": "external_browser_cli",
            "command": "ego-browser",
            "vendored": false
          }
        }
      },
      "runtime_preconditions": {
        "platform": "Darwin",
        "ego_browser": true,
        "chatgpt_login": true,
        "login_check": "runtime_only",
        "current_task_browser_capability": "runtime_verified",
        "visible_task_dispatch": "explicit_authority_only"
      },
      "alternative_executor": {
        "kind": "harness_builtin_browser",
        "status": "capability_probe_required",
        "selection": "current_task_execution_when_runtime_verified",
        "capability": "verified_equivalent_browser_executor",
        "requirements": [
          "authenticated_ChatGPT_session",
          "stable_semantic_controls",
          "authenticated_image_download"
        ]
      },
      "browser_handoff": {
        "required_when": "visible_task_creation_authority_explicit",
        "orchestrator": "project-handoff",
        "luna_route": "luna-max",
        "model": "gpt-5.6-luna",
        "reasoning": "max",
        "thread": "visible",
        "surface": "visible_thread",
        "worker_executor": "ego-browser",
        "execution_role": "browser_worker",
        "handoff_depth": 1,
        "recursive_dispatch": false,
        "ordinary_generation_request_grants_creation": false,
        "payload_author": "originating_main_task",
        "worker_creative_rewrite": false
      },
      "payload": {
        "required_before_handoff": ["final_image_prompt", "inputs", "output_path"],
        "worker_creative_rewrite": false
      },
      "capabilities": {
        "image": {
          "text_to_image": true,
          "image_to_image": "runtime_verification_required",
          "multi_image": "runtime_verification_required"
        }
      }
    },
    {
      "id": "minimax-mmx-image",
      "provider": "minimax",
      "status": "active_if_available",
      "selection": "non_codex_text_to_image_pre_submission_fallback",
      "executor": {
        "kind": "external_cli",
        "command": "mmx",
        "vendored": false,
        "upgrade_owner": "mmx-cli"
      },
      "capabilities": {
        "image": {
          "text_to_image": true,
          "subject_reference": true,
          "image_to_image": false,
          "multi_image": false
        }
      }
    },
    {
      "id": "agnes-image",
      "provider": "agnes",
      "model": "agnes-image-2.1-flash",
      "status": "active_if_configured",
      "selection": "explicit_or_user_confirmed",
      "credential_binding": {
        "file": "~/.codex/secrets/agnes.env",
        "inspection": "metadata_only"
      },
      "executor": {
        "kind": "package_script",
        "path": "scripts/agnes_media.py"
      },
      "capabilities": {
        "image": {
          "text_to_image": true,
          "image_to_image": true,
          "multi_image": true
        }
      }
    },
    {
      "id": "minimax-mmx-video",
      "provider": "minimax",
      "model_family": "MiniMax-H3",
      "status": "active_if_available",
      "selection": "default_after_quota_policy",
      "executor": {
        "kind": "external_cli",
        "command": "mmx",
        "vendored": false,
        "upgrade_owner": "mmx-cli"
      },
      "capabilities": {
        "video": {
          "text_to_video": true,
          "image_to_video": true,
          "first_last_frame": true,
          "reference_image": true,
          "reference_video": true,
          "reference_audio": true,
          "precise_video_edit": false
        }
      }
    },
    {
      "id": "agnes-video",
      "provider": "agnes",
      "model": "agnes-video-v2.0",
      "status": "active_if_configured",
      "selection": "explicit_or_user_confirmed_or_mmx_quota_choice",
      "credential_binding": {
        "file": "~/.codex/secrets/agnes.env",
        "inspection": "metadata_only"
      },
      "executor": {
        "kind": "package_script",
        "path": "scripts/agnes_media.py"
      },
      "capabilities": {
        "video": {
          "text_to_video": true,
          "image_to_video": true,
          "keyframes": true,
          "video_to_video": false,
          "precise_video_edit": false
        }
      }
    },
    {
      "id": "minimax-mmx-speech",
      "provider": "minimax",
      "status": "active_if_available",
      "selection": "default_for_speech",
      "executor": {
        "kind": "external_cli",
        "command": "mmx",
        "vendored": false,
        "upgrade_owner": "mmx-cli"
      },
      "capabilities": {
        "audio": {
          "text_to_speech": true,
          "subtitles": true
        }
      }
    },
    {
      "id": "minimax-web-music",
      "provider": "minimax_web",
      "status": "active_if_available",
      "selection": "default_for_generic_music",
      "url": "https://www.minimaxi.com/audio/music",
      "executor": {
        "kind": "authority_gated_browser_execution",
        "current_task": {
          "kind": "verified_browser_executor",
          "preferred_command": "ego-browser",
          "requires_visible_task_creation_authority": false
        },
        "visible_task": {
          "kind": "project_handoff_visible_thread",
          "orchestrator": "project-handoff",
          "route": "luna-max",
          "model": "gpt-5.6-luna",
          "reasoning": "max",
          "surface": "visible_thread",
          "requires_visible_task_creation_authority": true,
          "worker": {
            "kind": "external_browser_cli",
            "command": "ego-browser",
            "vendored": false
          }
        }
      },
      "alternative_executor": {
        "kind": "harness_builtin_browser",
        "status": "capability_probe_required",
        "selection": "current_task_execution_when_runtime_verified",
        "capability": "verified_equivalent_browser_executor",
        "requirements": [
          "authenticated_MiniMax_session",
          "stable_music_controls",
          "browser_context_download",
          "nonzero_mp3_readback"
        ]
      },
      "runtime_preconditions": {
        "platform": "Darwin",
        "ego_browser": true,
        "minimax_web_login": true,
        "output_path": "caller_authorized_absolute_path",
        "current_task_browser_capability": "runtime_verified",
        "visible_task_dispatch": "explicit_authority_only"
      },
      "browser_handoff": {
        "required_when": "visible_task_creation_authority_explicit",
        "orchestrator": "project-handoff",
        "luna_route": "luna-max",
        "model": "gpt-5.6-luna",
        "reasoning": "max",
        "thread": "visible",
        "surface": "visible_thread",
        "worker_executor": "ego-browser",
        "execution_role": "browser_worker",
        "handoff_depth": 1,
        "recursive_dispatch": false,
        "ordinary_generation_request_grants_creation": false,
        "payload_author": "originating_main_task",
        "worker_creative_rewrite": false
      },
      "payload": {
        "required_before_handoff": [
          "title",
          "mode",
          "style_prompt",
          "lyrics",
          "count",
          "output_path"
        ],
        "default_count": 1,
        "worker_creative_rewrite": false
      },
      "runtime_controls": ["model", "cost", "count", "login", "output_path"],
      "completion": {
        "wait_for": "full_completion",
        "download_format": "mp3",
        "verify": ["regular_file", "nonzero_size", "mp3_type", "sha256"]
      },
      "capabilities": {
        "music": {
          "original_song": true,
          "instrumental_bgm": true,
          "vocal_song": true,
          "voice_cloning": false,
          "reference_audio_editing": false,
          "cover": false,
          "exact_duration": false,
          "commercial_license": "not_claimed"
        }
      }
    },
    {
      "id": "minimax-mmx-music",
      "provider": "minimax",
      "status": "legacy_if_explicit_and_eligible",
      "selection": "explicit_only_after_runtime_eligibility_confirmation",
      "eligibility": {
        "official_notice_date": "2026-08-20",
        "new_users_paid_music_api": "not_offered",
        "historical_paid_api_users": "may_continue_after_runtime_confirmation",
        "free_music_models": "stopped",
        "local_cli_help": "interface_evidence_only"
      },
      "executor": {
        "kind": "external_cli",
        "command": "mmx",
        "vendored": false,
        "upgrade_owner": "mmx-cli"
      },
      "capabilities": {
        "audio": {
          "text_to_music": true,
          "instrumental": true,
          "lyrics": true,
          "music_cover": true
        }
      }
    }
  ]
}
